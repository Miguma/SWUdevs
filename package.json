{
  "name": "tambayayong",
  "version": "1.1.0-preview.2",
  "description": "From conversation to action. Walay mabilin! - Open-source bilingual meeting intelligence.",
  "private": true,
  "scripts": {
    "predev": "node -e \"try { const fs = require('fs'); if (fs.existsSync('.next/BUILD_ID')) fs.rmSync('.next', { recursive: true, force: true }); } catch (e) {}\"",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx eval/validate-dataset.ts",
    "eval:validate": "tsx eval/validate-dataset.ts",
    "eval:model": "tsx eval/run-model-eval.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "check": "npm run eval:validate && npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@hookform/resolvers": "^3.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.35.3",
    "idb": "^8.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.454.0",
    "next": "^14.2.18",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "tailwind-merge": "^2.5.4",
    "unpdf": "^1.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=22"
  }
}
