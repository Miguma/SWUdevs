# Environment variables for Tambayayong

# Ollama local inference host
OLLAMA_HOST=http://localhost:11434

# Primary local model identifier (Apache 2.0 license)
# Recommended: qwen3:4b or qwen2.5:3b or qwen2.5:7b
OLLAMA_MODEL=qwen3:4b

# Optional cloud analysis with the Apache-2.0 Qwen/Qwen3-32B model.
# Keep this token on the server. It needs Hugging Face Inference Providers permission.
# The app pins DeepInfra and never switches to another cloud model/provider.
HF_TOKEN=

# Default timezone for relative meeting deadlines
DEFAULT_TIMEZONE=Asia/Manila

# Optional PostgreSQL Database URL (for server-synced workspaces)
DATABASE_URL=postgresql://tambayayong:tambayayong@localhost:5432/tambayayong_db

# Application Port
PORT=3000

# Bound input to fit the configured local context; larger notes are rejected, never truncated.
MAX_PROMPT_CHARS=24000
INFERENCE_TIMEOUT_MS=90000
MAX_CONCURRENT_INFERENCES=2
