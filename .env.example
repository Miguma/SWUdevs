# Environment variables for Tambayayong

# Cloud analysis with the Apache-2.0 Qwen 3.8 27B model on Groq's free tier.
# Keep the API key on the server. The app never switches models or providers.
GROQ_API_KEY=

# Supabase Auth and signed-in meeting sync. Use the project's publishable key,
# never a service_role or secret key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Default timezone for relative meeting deadlines
DEFAULT_TIMEZONE=Asia/Manila

# Optional PostgreSQL Database URL (for server-synced workspaces)
DATABASE_URL=postgresql://tambayayong:tambayayong@localhost:5432/tambayayong_db

# Application Port
PORT=3000
